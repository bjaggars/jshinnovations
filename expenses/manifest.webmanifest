{
  "name": "JSH Expenses",
  "short_name": "Expenses",
  "description": "Receipt capture and expense reports for Jaggars Software Holdings",
  "start_url": "/expenses/#inbox",
  "scope": "/expenses/",
  "display": "standalone",
  "background_color": "#f5f6f4",
  "theme_color": "#0f3d3a",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/expenses/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "id": "/expenses/"
}